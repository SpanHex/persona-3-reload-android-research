{
  "test_suite_version": "2.0.0-phase3.1-authoritative",
  "target_guest_isa": "x86_64",
  "target_host_isa": "aarch64",
  "target_platform": "android-arm64",
  "abi_version": 2,
  "oracle_source": "Unicorn Engine 2.1.4 x86-64 CPU Emulator (Direct ELF Execution)",
  "fixtures": [
    {
      "id": "01_arithmetic",
      "source": "phase3-poc/tests/fixtures/01_arithmetic.c",
