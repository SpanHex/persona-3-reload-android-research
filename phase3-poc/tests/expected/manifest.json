      "description": "Integer arithmetic, high-byte registers (ah/ch/dh/bh), safe division, scalar floats, recursion (factorial, fibonacci)",
      "entrypoint_symbol": "run_fixture_01",
      "expected_hex": "0xc7c63fc50b2aeb68",
      "expected_uint64": 14395279621376994152,
      "status": "AUTHORITATIVE_ORACLE_VERIFIED"
    },
    {
      "id": "02_dispatch",
      "source": "phase3-poc/tests/fixtures/02_dispatch.c",
      "binary": "phase3-poc/tests/bin/02_dispatch.elf",
